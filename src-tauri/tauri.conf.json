{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "1.0.4",
  "identifier": "com.makotoarai.aura",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aura",
        "width": 1000,
        "height": 670,
        "minWidth": 600,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "developmentTeam": ""
    },
    "windows": {
      "wix": null,
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
